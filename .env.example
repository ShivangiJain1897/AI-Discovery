# Copy to .env.local for local dev, or set these on your host (e.g. Vercel).
# Everything is optional for local use — the app runs in demo mode with a local
# file store and no password. For a shared deployment, set all three.

# --- Live AI outputs (optional locally; recommended for a real deployment) ---
# Without a key the app runs in DEMO MODE (illustrative seed outputs).
ANTHROPIC_API_KEY=
# Optional model override.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Data store (REQUIRED for deployment) ---
# With no DATABASE_URL the app uses a local .data/*.json file store (fine for
# dev, but a cloud host's filesystem is ephemeral — set this in production).
# A Postgres connection string from Neon, Supabase, Vercel Postgres, RDS, etc.
DATABASE_URL=

# --- Shared password gate (optional; recommended for a shared deployment) ---
# If set, the whole app requires this password (HTTP Basic auth, any username).
# Leave blank for an open/local instance.
APP_PASSWORD=
