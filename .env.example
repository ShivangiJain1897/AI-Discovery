# ─────────────────────────────────────────────────────────────
# AI Product Discovery Platform — environment template
# Copy to .env and fill in. Every provider is swappable here.
# ─────────────────────────────────────────────────────────────

# ── Core ────────────────────────────────────────────────────
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
SECRET_KEY=change-me-in-production

# ── Database (Postgres + pgvector) ──────────────────────────
DATABASE_URL=postgresql+psycopg://discovery:discovery@localhost:5432/discovery
# Dimension must match the embedding provider's output size.
EMBEDDING_DIMENSION=1024

# ── LLM provider ────────────────────────────────────────────
# anthropic | mock
# Falls back to `mock` automatically when no key is present, so the
# app and its tests always run without credentials.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
# Optional: for organization/workspace-scoped keys
ANTHROPIC_WORKSPACE_ID=
LLM_MAX_TOKENS=8000
LLM_TIMEOUT_SECONDS=180

# ── Web search provider ─────────────────────────────────────
# tavily | brave | mock
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_API_KEY=
SEARCH_RESULTS_PER_QUERY=8
SEARCH_TIMEOUT_SECONDS=45

# ── Embeddings provider ─────────────────────────────────────
# voyage | mock
EMBEDDING_PROVIDER=mock
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# ── Object storage (uploads + generated documents) ──────────
# local | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Research behaviour ──────────────────────────────────────
MAX_SOURCES_PER_RUN=40
MAX_EVIDENCE_PER_SOURCE=12
RESEARCH_CONCURRENCY=4

# ── Safety / governance ─────────────────────────────────────
# Scans text for PII/PHI before it leaves for a model provider.
PHI_DETECTION_ENABLED=true
# block | redact | warn
PHI_ON_DETECT=warn
AUDIT_LOG_ENABLED=true
DATA_RETENTION_DAYS=365

# ── Frontend ────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
